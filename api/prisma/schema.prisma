generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id           Int     @id @default(autoincrement())
  nombre       String
  nit          String? @unique
  direccion    String?
  telefono     String?
  correo       String?
  logo         String?
  ciudad       String?
  configuracion Json?   @default("{}")
  activo       Boolean @default(true)
  licenciaActiva Boolean @default(true)

  usuarios      Usuario[]
  productos     Producto[]
  ventas        Venta[]
  compras       Compra[]
  proveedores   Proveedor[]
  auditorias    Auditoria[]
  movimientos   MovimientoInventario[]

  @@map("empresas")
}

model Producto {
  id             Int            @id @default(autoincrement())
  codigo         String         @unique
  nombre         String         @unique
  precioVenta    Int
  stock          Int
  activo         Boolean        @default(true)
  
  empresaId      Int?
  empresa        Empresa?       @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  detalleVentas  DetalleVenta[]
  detalleCompras DetalleCompra[]
  movimientos    MovimientoInventario[]

  @@map("productos")
}

model Rol {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id         Int     @id @default(autoincrement())
  nombre     String
  apellido   String
  correo     String  @unique
  contrasena String
  activo     Boolean @default(true)

  rolId      Int
  rol        Rol       @relation(fields: [rolId], references: [id], onDelete: Restrict)
  
  empresaId  Int?
  empresa    Empresa?  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  ventas     Venta[]
  compras    Compra[]
  auditorias Auditoria[]
  movimientosInventario MovimientoInventario[]

  @@map("usuarios")
}

model Venta {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @default(now())
  total     Int
  activo    Boolean  @default(true)
  metodoPago String  @default("EFECTIVO")
  referencia String?

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  detalles DetalleVenta[]

  @@map("ventas")
}

model DetalleVenta {
  id Int @id @default(autoincrement())

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  cantidad       Int
  precioUnitario Int @map("preciounitario")
  subtotal       Int

  @@map("detalle_ventas")
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  nombre    String
  nit       String?  @unique
  telefono  String?
  correo    String?
  direccion String?
  activo    Boolean  @default(true)

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  compras Compra[]

  @@map("proveedores")
}

model Compra {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @default(now())
  total     Int
  activo    Boolean  @default(true)

  proveedorId Int
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  detalles DetalleCompra[]

  @@map("compras")
}

model DetalleCompra {
  id Int @id @default(autoincrement())

  compraId Int
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Restrict)

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  cantidad     Int
  precioCompra Int
  subtotal     Int

  @@map("detalle_compras")
}

model Auditoria {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())

  usuarioId   Int
  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  empresaId   Int?
  empresa     Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  modulo      String
  accion      String
  descripcion String

  @@map("auditoria")
}

model MovimientoInventario {
  id             Int      @id @default(autoincrement())
  fecha          DateTime @default(now())

  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  usuarioId      Int
  usuario        Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  empresaId      Int?
  empresa        Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  tipo           TipoMovimiento
  origenId       Int?

  cantidad       Int

  stockAnterior  Int
  stockNuevo     Int

  observacion    String?

  @@map("movimientos_inventario")
}

enum TipoMovimiento {
  COMPRA
  VENTA
  AJUSTE
  MERMA
  DEVOLUCION
  ELIMINACION
}